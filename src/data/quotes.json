[
  { "id": "aq01-ko", "text": "내려놓는 순간, 새로운 계절이 시작된다.", "author": "", "lang": "ko", "tags": ["beginning", "change"] },
  { "id": "aq01-en", "text": "A new season begins when you let go.", "author": "", "lang": "en", "tags": ["beginning", "change"] },
  { "id": "aq02-ko", "text": "나무는 비워질 때도 아름답다.", "author": "", "lang": "ko", "tags": ["growth", "peace"] },
  { "id": "aq02-en", "text": "Trees are beautiful even as they let go.", "author": "", "lang": "en", "tags": ["growth", "peace"] },
  { "id": "aq03-ko", "text": "끝이라고 생각한 자리에도 빛은 남는다.", "author": "", "lang": "ko", "tags": ["comfort", "reflection"] },
  { "id": "aq03-en", "text": "Light remains where you thought it ended.", "author": "", "lang": "en", "tags": ["comfort", "reflection"] },
  { "id": "aq04-ko", "text": "변하는 것은 사라지는 것과 다르다.", "author": "", "lang": "ko", "tags": ["change", "growth"] },
  { "id": "aq04-en", "text": "To change is not to disappear.", "author": "", "lang": "en", "tags": ["change", "growth"] },
  { "id": "aq05-ko", "text": "오늘의 낙엽은 내일의 숲을 키운다.", "author": "", "lang": "ko", "tags": ["growth", "change"] },
  { "id": "aq05-en", "text": "Today's fallen leaves nourish tomorrow's forest.", "author": "", "lang": "en", "tags": ["growth", "change"] },
  { "id": "aq06-ko", "text": "모든 계절에 꽃을 피울 필요는 없다.", "author": "", "lang": "ko", "tags": ["peace", "growth"] },
  { "id": "aq06-en", "text": "You don't have to bloom in every season.", "author": "", "lang": "en", "tags": ["peace", "growth"] },
  { "id": "aq07-ko", "text": "느리게 걸으면 계절이 말을 건다.", "author": "", "lang": "ko", "tags": ["journey", "reflection"] },
  { "id": "aq07-en", "text": "Walk slowly, and the season speaks.", "author": "", "lang": "en", "tags": ["journey", "reflection"] },
  { "id": "aq08-ko", "text": "쉬어가는 시간도 삶의 한 장면이다.", "author": "", "lang": "ko", "tags": ["comfort", "peace"] },
  { "id": "aq08-en", "text": "Rest is a scene in your story, too.", "author": "", "lang": "en", "tags": ["comfort", "peace"] },
  { "id": "aq09-ko", "text": "마음에도 햇볕이 드는 자리를 남겨두자.", "author": "", "lang": "ko", "tags": ["comfort", "peace"] },
  { "id": "aq09-en", "text": "Leave a little room for sunlight in your heart.", "author": "", "lang": "en", "tags": ["comfort", "peace"] },
  { "id": "aq10-ko", "text": "고요함은 나를 다시 듣는 시간이다.", "author": "", "lang": "ko", "tags": ["solitude", "reflection"] },
  { "id": "aq10-en", "text": "In stillness, I hear myself again.", "author": "", "lang": "en", "tags": ["solitude", "reflection"] },
  { "id": "aq11-ko", "text": "바람이 지나갈 때까지 잠시 쉬어도 좋다.", "author": "", "lang": "ko", "tags": ["comfort", "peace"] },
  { "id": "aq11-en", "text": "It's okay to rest while the wind passes.", "author": "", "lang": "en", "tags": ["comfort", "peace"] },
  { "id": "aq12-ko", "text": "아무것도 하지 않는 오후에도 의미는 있다.", "author": "", "lang": "ko", "tags": ["peace", "comfort"] },
  { "id": "aq12-en", "text": "Even an idle afternoon has meaning.", "author": "", "lang": "en", "tags": ["peace", "comfort"] },
  { "id": "aq13-ko", "text": "작은 온기가 하루의 색을 바꾼다.", "author": "", "lang": "ko", "tags": ["comfort", "change"] },
  { "id": "aq13-en", "text": "A little warmth changes the color of a day.", "author": "", "lang": "en", "tags": ["comfort", "change"] },
  { "id": "aq14-ko", "text": "평범한 길도 계절을 만나면 특별해진다.", "author": "", "lang": "ko", "tags": ["journey", "change"] },
  { "id": "aq14-en", "text": "An ordinary path becomes special with the season.", "author": "", "lang": "en", "tags": ["journey", "change"] },
  { "id": "aq15-ko", "text": "행복은 먼 곳보다 자세히 본 곳에 있다.", "author": "", "lang": "ko", "tags": ["peace", "reflection"] },
  { "id": "aq15-en", "text": "Happiness lives where you look closely.", "author": "", "lang": "en", "tags": ["peace", "reflection"] },
  { "id": "aq16-ko", "text": "오늘의 빛은 오늘만의 선물이다.", "author": "", "lang": "ko", "tags": ["reflection", "beginning"] },
  { "id": "aq16-en", "text": "Today's light is a gift for today alone.", "author": "", "lang": "en", "tags": ["reflection", "beginning"] },
  { "id": "aq17-ko", "text": "비 오는 날에도 마음의 온도는 지킬 수 있다.", "author": "", "lang": "ko", "tags": ["comfort", "challenge"] },
  { "id": "aq17-en", "text": "Even in the rain, you can keep your heart warm.", "author": "", "lang": "en", "tags": ["comfort", "challenge"] },
  { "id": "aq18-ko", "text": "풍경을 바라보는 순간도 삶을 채운다.", "author": "", "lang": "ko", "tags": ["peace", "journey"] },
  { "id": "aq18-en", "text": "A moment spent watching fills a life, too.", "author": "", "lang": "en", "tags": ["peace", "journey"] },
  { "id": "aq19-ko", "text": "나의 속도로 익어가는 중이다.", "author": "", "lang": "ko", "tags": ["growth", "solitude"] },
  { "id": "aq19-en", "text": "I'm ripening at my own pace.", "author": "", "lang": "en", "tags": ["growth", "solitude"] },
  { "id": "aq20-ko", "text": "가장 깊은 색은 시간을 지나 만들어진다.", "author": "", "lang": "ko", "tags": ["growth", "reflection"] },
  { "id": "aq20-en", "text": "The deepest colors take time.", "author": "", "lang": "en", "tags": ["growth", "reflection"] },
  { "id": "aq21-ko", "text": "길이 굽어도 나의 걸음은 앞으로 간다.", "author": "", "lang": "ko", "tags": ["challenge", "journey"] },
  { "id": "aq21-en", "text": "Even on a winding path, I move forward.", "author": "", "lang": "en", "tags": ["challenge", "journey"] },
  { "id": "aq22-ko", "text": "계절이 바뀌듯, 나도 달라질 수 있다.", "author": "", "lang": "ko", "tags": ["change", "growth"] },
  { "id": "aq22-en", "text": "Like the seasons, I can change.", "author": "", "lang": "en", "tags": ["change", "growth"] },
  { "id": "aq23-ko", "text": "지나온 시간도 나를 물들이는 빛이다.", "author": "", "lang": "ko", "tags": ["reflection", "growth"] },
  { "id": "aq23-en", "text": "The days behind me still color who I am.", "author": "", "lang": "en", "tags": ["reflection", "growth"] },
  { "id": "aq24-ko", "text": "오늘 한 걸음이면, 오늘은 충분하다.", "author": "", "lang": "ko", "tags": ["beginning", "comfort"] },
  { "id": "aq24-en", "text": "One step is enough for today.", "author": "", "lang": "en", "tags": ["beginning", "comfort"] }
]
